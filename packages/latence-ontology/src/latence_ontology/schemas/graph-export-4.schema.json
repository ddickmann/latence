{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "graph-export/4",
 "type": "object",
 "required": [
  "schema",
  "meta",
  "concepts",
  "relations",
  "measures",
  "dropped",
  "nodes",
  "edges",
  "review"
 ],
 "properties": {
  "schema": {
   "const": "graph-export/4"
  },
  "meta": {
   "type": "object",
   "required": [
    "source",
    "title",
    "schema_origin",
    "counts",
    "decisions",
    "host_verified_joins",
    "instances"
   ],
   "properties": {
    "schema_origin": {
     "enum": [
      "induced",
      "declared"
     ]
    },
    "resolution": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "seeded",
      "master",
      "records",
      "labels",
      "target",
      "certified",
      "pairs",
      "linked",
      "review_pairs",
      "state",
      "truth_stands_in",
      "certified_on"
     ],
     "properties": {
      "seeded": {
       "type": "boolean"
      },
      "certified": {
       "type": "boolean"
      },
      "reject_line_certified": {
       "type": "boolean"
      },
      "target": {
       "type": "number"
      },
      "labels": {
       "type": "object",
       "required": [
        "training",
        "accept_test",
        "reject_test",
        "total"
       ],
       "additionalProperties": false,
       "properties": {
        "training": {
         "type": "object",
         "required": [
          "reviewer",
          "simulated",
          "open"
         ],
         "additionalProperties": false,
         "properties": {
          "reviewer": {
           "type": "integer",
           "minimum": 0
          },
          "simulated": {
           "type": "integer",
           "minimum": 0
          },
          "open": {
           "type": "integer",
           "minimum": 0
          }
         }
        },
        "accept_test": {
         "type": "object",
         "required": [
          "reviewer",
          "simulated",
          "open"
         ],
         "additionalProperties": false,
         "properties": {
          "reviewer": {
           "type": "integer",
           "minimum": 0
          },
          "simulated": {
           "type": "integer",
           "minimum": 0
          },
          "open": {
           "type": "integer",
           "minimum": 0
          }
         }
        },
        "reject_test": {
         "type": "object",
         "required": [
          "reviewer",
          "simulated",
          "open"
         ],
         "additionalProperties": false,
         "properties": {
          "reviewer": {
           "type": "integer",
           "minimum": 0
          },
          "simulated": {
           "type": "integer",
           "minimum": 0
          },
          "open": {
           "type": "integer",
           "minimum": 0
          }
         }
        },
        "total": {
         "type": "integer"
        }
       }
      },
      "checked_against_seed": {
       "type": "object",
       "required": [
        "linked",
        "linked_right",
        "share_right",
        "share_found"
       ]
      },
      "state": {
       "enum": [
        "certified",
        "not_certified",
        "awaiting_training",
        "awaiting_tests"
       ]
      },
      "certified_on": {
       "enum": [
        "reviewer",
        "mixed",
        "simulated",
        null
       ]
      },
      "truth_stands_in": {
       "type": "boolean"
      }
     }
    },
    "lineage": {
     "type": "object",
     "required": [
      "read",
      "edges",
      "outside_the_estate"
     ],
     "properties": {
      "read": {
       "const": true
      },
      "edges": {
       "type": "integer",
       "minimum": 0
      },
      "outside_the_estate": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "renames": {
     "type": "object",
     "required": [
      "carried",
      "refused"
     ],
     "description": "What the renames people confirmed carried, and what was refused, with the reason (ticket 57).",
     "properties": {
      "carried": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "from",
         "to",
         "iri"
        ]
       }
      },
      "refused": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "from",
         "to",
         "reason"
        ]
       }
      }
     }
    },
    "crosswalk": {
     "type": "object",
     "required": [
      "tables",
      "matched",
      "without_key",
      "several_keys"
     ],
     "description": "The host's alias tables read (metis.alias/1, each with its version and the catalog version it was read from), and which elements got no key or several (ticket 57).",
     "properties": {
      "tables": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "format",
         "namespace",
         "version",
         "catalog",
         "read_from"
        ],
        "properties": {
         "format": {
          "const": "metis.alias/1"
         },
         "namespace": {
          "type": "string"
         },
         "version": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
         },
         "catalog": {
          "type": "string"
         },
         "read_from": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
         }
        }
       }
      },
      "without_key": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "views_named_twice": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Metric view names two schemas of the estate hold: a platform id names a view by its name only, so neither is matched."
      }
     }
    }
   }
  },
  "concepts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/concept"
   }
  },
  "relations": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/relation"
   }
  },
  "measures": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/measure"
   }
  },
  "dropped": {
   "type": "array"
  },
  "nodes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "concept",
     "label"
    ]
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "from",
     "to",
     "kind"
    ],
    "properties": {
     "kind": {
      "enum": [
       "refers_to",
       "fact_count",
       "meet_in",
       "same_as",
       "broader"
      ]
     },
     "p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/statement"
      }
     },
     "decided_by": {
      "type": "string"
     },
     "claim": {
      "description": "On a `same_as` link a person decided: the claim of the pair as its review item stated it, so that a decision can be checked on it once the pair is no longer listed.",
      "$ref": "#/$defs/claim"
     },
     "actor": {
      "description": "On a `same_as` link: who made it, `engine` or `human:<id>` (a model's verdict links nothing by itself).",
      "type": "string",
      "pattern": "^(engine|human:.+)$"
     },
     "rows": {
      "type": "integer",
      "minimum": 1,
      "description": "On a `broader` edge: the rows within the step's own objects that hold the member under the value it points to."
     },
     "member_rows": {
      "type": "integer",
      "minimum": 1,
      "description": "On a `broader` edge (graph-export/4): the member's rows within the step's own objects, whatever the coarser column holds. `rows` counts a subset of them, so `rows / member_rows` is at most 1; the member node's own `rows` is counted over other objects."
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "kind": {
         "const": "broader"
        }
       },
       "required": [
        "kind"
       ]
      },
      "then": {
       "required": [
        "rows",
        "member_rows"
       ]
      }
     }
    ]
   }
  },
  "review": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "a",
     "b",
     "reasons",
     "strength",
     "claim"
    ],
    "properties": {
     "kind": {
      "enum": [
       "possibly_same"
      ]
     },
     "strength": {
      "enum": [
       "strong",
       "weak"
      ]
     },
     "p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/statement"
      }
     },
     "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
       "$ref": "#/$defs/statement"
      }
     },
     "claim": {
      "$ref": "#/$defs/claim"
     },
     "in_layer": {
      "$ref": "#/$defs/in_layer"
     },
     "model_vote": {
      "description": "A hosted model's verdict on a pair of records the linker left undecided (ticket 48): a vote with its actor, which decides nothing.",
      "type": "object",
      "required": [
       "verdict",
       "actor"
      ],
      "additionalProperties": false,
      "properties": {
       "verdict": {
        "enum": [
         "same",
         "different",
         "unsure"
        ]
       },
       "actor": {
        "type": "string",
        "pattern": "^model:.+"
       }
      }
     },
     "state": {
      "$ref": "#/$defs/state"
     },
     "certification": {
      "$ref": "#/$defs/certification"
     }
    }
   }
  },
  "structure": {
   "type": "object",
   "required": [
    "describes",
    "equivalent",
    "not_proposed",
    "part_of",
    "roll_ups"
   ],
   "additionalProperties": false,
   "properties": {
    "roll_ups": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "id",
       "signals",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "breaking": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "value",
          "parents"
         ],
         "additionalProperties": false,
         "properties": {
          "value": {
           "type": "string"
          },
          "parents": {
           "type": "array",
           "minItems": 2,
           "items": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     }
    },
    "equivalent": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "id",
       "signals",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "claim": {
        "$ref": "#/$defs/claim"
       }
      }
     }
    },
    "part_of": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "id",
       "signals",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "kind": {
        "enum": [
         "part_of",
         "links"
        ]
       }
      }
     }
    },
    "describes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "id",
       "signals",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "claim": {
        "$ref": "#/$defs/claim"
       }
      }
     }
    },
    "not_proposed": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "concept",
       "signals"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^not_proposed:"
       },
       "concept": {
        "type": "string"
       },
       "entity": {
        "type": "string"
       },
       "signals": {
        "type": "array",
        "minItems": 1,
        "items": {
         "$ref": "#/$defs/signal"
        }
       }
      }
     }
    }
   }
  },
  "classes": {
   "type": "object",
   "required": [
    "top",
    "classes",
    "subclass_of",
    "voices",
    "unplaced"
   ],
   "properties": {
    "top": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "label",
       "label_code",
       "definition",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "definition": {
        "$ref": "#/$defs/texts"
       },
       "label_code": {
        "type": "string"
       },
       "iri": {
        "$ref": "#/$defs/iri"
       }
      }
     }
    },
    "classes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "label",
       "parent",
       "definition",
       "status",
       "signals",
       "claim"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "definition": {
        "$ref": "#/$defs/texts"
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "iri": {
        "$ref": "#/$defs/iri"
       }
      }
     }
    },
    "subclass_of": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "concept",
       "parent",
       "status",
       "contested",
       "signals",
       "definition",
       "claim"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed"
        ]
       },
       "contested": {
        "type": "boolean"
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "definition": {
        "$ref": "#/$defs/texts"
       },
       "claim": {
        "$ref": "#/$defs/claim"
       }
      }
     }
    },
    "voices": {
     "type": "object",
     "required": [
      "attribute_pattern",
      "language_model"
     ]
    },
    "unplaced": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "label_requests": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "training": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "kind",
       "a",
       "b",
       "evidence",
       "label",
       "by",
       "claim"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^same:"
       },
       "kind": {
        "const": "possibly_same"
       },
       "label": {
        "enum": [
         "same",
         "different",
         null
        ]
       },
       "by": {
        "enum": [
         "reviewer",
         "simulated",
         null
        ]
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "evidence": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/statement"
        }
       },
       "p": false
      }
     }
    },
    "accept_test": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "kind",
       "a",
       "b",
       "evidence",
       "label",
       "by",
       "claim"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^same:"
       },
       "kind": {
        "const": "possibly_same"
       },
       "label": {
        "enum": [
         "same",
         "different",
         null
        ]
       },
       "by": {
        "enum": [
         "reviewer",
         "simulated",
         null
        ]
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "evidence": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/statement"
        }
       },
       "p": false
      }
     }
    },
    "reject_test": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "kind",
       "a",
       "b",
       "evidence",
       "label",
       "by",
       "claim"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^same:"
       },
       "kind": {
        "const": "possibly_same"
       },
       "label": {
        "enum": [
         "same",
         "different",
         null
        ]
       },
       "by": {
        "enum": [
         "reviewer",
         "simulated",
         null
        ]
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "evidence": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/statement"
        }
       },
       "p": false
      }
     }
    }
   }
  },
  "lineage": {
   "description": "What the catalog's lineage says each concept is made from, between concepts of the estate. Absent where the reader keeps no lineage (a mirror).",
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "from",
     "to",
     "source"
    ],
    "additionalProperties": false,
    "properties": {
     "from": {
      "type": "string",
      "pattern": "^concept:"
     },
     "to": {
      "type": "string",
      "pattern": "^concept:"
     },
     "source": {
      "const": "catalog"
     }
    }
   }
  },
  "drift": {
   "description": "What drifted in the catalog under an element a person decided (ticket 53): the old decision is stale and no longer applied, and the element is a proposal again. Absent when nothing drifted.",
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "subject",
     "kind",
     "drift",
     "decided_on",
     "verdict",
     "by",
     "now"
    ],
    "properties": {
     "drift": {
      "enum": [
       "renamed",
       "retyped",
       "split",
       "dropped"
      ]
     },
     "kind": {
      "enum": [
       "concept",
       "relation"
      ]
     },
     "now": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "mentions": {
   "description": "Mentions of the estate's rows in its documents (ticket 42): a half-open character span of a document, linked to the one row it names, or to its candidates where two rows carry the name. Absent without documents.",
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "document",
     "digest",
     "start",
     "end",
     "text"
    ],
    "additionalProperties": false,
    "properties": {
     "document": {
      "type": "string"
     },
     "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     },
     "start": {
      "type": "integer",
      "minimum": 0
     },
     "end": {
      "type": "integer",
      "minimum": 1
     },
     "text": {
      "type": "string",
      "minLength": 3
     },
     "node": {
      "type": "string"
     },
     "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 },
 "$defs": {
  "signal": {
   "$ref": "#/$defs/statement"
  },
  "decision": {
   "type": "object",
   "required": [
    "verdict",
    "by"
   ],
   "properties": {
    "verdict": {
     "enum": [
      "approved",
      "rejected"
     ]
    },
    "calibration": {
     "description": "On an approval by the engine: the calibration record that proves its kind safe (ticket 51).",
     "type": "string"
    }
   }
  },
  "concept": {
   "type": "object",
   "required": [
    "claim",
    "definition",
    "id",
    "instances",
    "kind",
    "label",
    "signals",
    "status"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^concept:"
    },
    "status": {
     "enum": [
      "declared",
      "proposed"
     ]
    },
    "kind": {
     "enum": [
      "entity",
      "fact",
      "reference",
      "derived"
     ]
    },
    "instances": {
     "enum": [
      "available",
      "withheld_personal",
      "without_personal_columns"
     ]
    },
    "signals": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/signal"
     }
    },
    "attributes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "column",
       "label",
       "type",
       "sensitive"
      ],
      "additionalProperties": false,
      "properties": {
       "column": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "type": {
        "type": "string"
       },
       "definition": {
        "$ref": "#/$defs/texts"
       },
       "sensitive": {
        "type": "boolean"
       },
       "masked": {
        "description": "The catalog masks the column: no statement of the engine selects it (it is sensitive too).",
        "const": true
       }
      }
     }
    },
    "decision": {
     "$ref": "#/$defs/decision"
    },
    "seeded": {
     "type": "boolean"
    },
    "proposal": {
     "description": "Present on a stated master list the estate names for a proposal file (its records' names may go to a host's semantic layer once a person approves it), so that a page offers a decision on it. Absent on everything else, a seeded list included. No part of the claim.",
     "const": "names"
    },
    "claim": {
     "$ref": "#/$defs/claim"
    },
    "definition": {
     "$ref": "#/$defs/texts"
    },
    "in_layer": {
     "$ref": "#/$defs/in_layer"
    },
    "row_filter": {
     "description": "The function of the catalog's row filter on the object, where it has one: what the engine counted there is what its identity may see.",
     "type": "string",
     "minLength": 1
    },
    "state": {
     "$ref": "#/$defs/state"
    },
    "certification": {
     "$ref": "#/$defs/certification"
    },
    "iri": {
     "$ref": "#/$defs/iri"
    },
    "labels": {
     "$ref": "#/$defs/labels"
    },
    "match": {
     "$ref": "#/$defs/match"
    }
   }
  },
  "relation": {
   "type": "object",
   "required": [
    "cardinality",
    "claim",
    "columns",
    "from",
    "id",
    "label",
    "signals",
    "status",
    "support",
    "to"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^relation:"
    },
    "status": {
     "enum": [
      "declared",
      "proposed"
     ]
    },
    "signals": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/signal"
     }
    },
    "support": {
     "type": [
      "object",
      "null"
     ]
    },
    "decision": {
     "$ref": "#/$defs/decision"
    },
    "claim": {
     "$ref": "#/$defs/claim"
    },
    "partial_key": {
     "const": true
    },
    "cardinality": {
     "enum": [
      "many_to_one",
      "many_to_many"
     ]
    },
    "state": {
     "$ref": "#/$defs/state"
    },
    "certification": {
     "$ref": "#/$defs/certification"
    },
    "iri": {
     "$ref": "#/$defs/iri"
    }
   }
  },
  "measure": {
   "type": "object",
   "required": [
    "claim",
    "concept",
    "definition",
    "expr",
    "id",
    "label",
    "name",
    "signals",
    "status",
    "view"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^measure:"
    },
    "status": {
     "const": "declared"
    },
    "claim": {
     "$ref": "#/$defs/claim"
    },
    "definition": {
     "$ref": "#/$defs/texts"
    },
    "state": {
     "$ref": "#/$defs/state"
    },
    "certification": {
     "$ref": "#/$defs/certification"
    },
    "iri": {
     "$ref": "#/$defs/iri"
    },
    "labels": {
     "$ref": "#/$defs/labels"
    },
    "match": {
     "$ref": "#/$defs/match"
    }
   }
  },
  "text": {
   "type": "object",
   "required": [
    "text",
    "lang",
    "origin"
   ],
   "additionalProperties": false,
   "properties": {
    "text": {
     "type": "string",
     "minLength": 1
    },
    "lang": {
     "type": "string",
     "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
    },
    "origin": {
     "type": "string",
     "pattern": "^(catalog|engine|model:.+)$"
    },
    "code": {
     "type": "string"
    }
   }
  },
  "texts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/text"
   }
  },
  "statement": {
   "type": "object",
   "required": [
    "kind",
    "code",
    "params",
    "ref"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "type": "string"
    },
    "code": {
     "type": "string",
     "pattern": "^[a-z_]+(\\.[a-z_]+)*$"
    },
    "params": {
     "type": "object",
     "additionalProperties": {
      "type": [
       "string",
       "number",
       "array"
      ],
      "items": {
       "type": "string"
      }
     }
    },
    "ref": {
     "type": "string"
    },
    "text": {
     "$ref": "#/$defs/text"
    }
   }
  },
  "claim": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  },
  "in_layer": {
   "description": "On an approved element: the release of a host's library that took it up, as a receipt of the host says (the library, and its version). Absent where no receipt says so.",
   "type": "object",
   "required": [
    "library",
    "version"
   ],
   "additionalProperties": false,
   "properties": {
    "library": {
     "type": "string",
     "minLength": 1
    },
    "version": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "state": {
   "description": "The element's place in the lifecycle (ticket 51): proposed, approved (a named reviewer, or the engine under a calibration), certified (the data owner, on an approved element), retired (withdrawn). A draft is not shown.",
   "enum": [
    "proposed",
    "approved",
    "certified",
    "retired"
   ]
  },
  "certification": {
   "type": "object",
   "required": [
    "by",
    "at"
   ],
   "additionalProperties": false,
   "properties": {
    "by": {
     "type": "string",
     "minLength": 1
    },
    "at": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
   }
  },
  "iri": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9+.-]*:\\S*x[0-9a-f]{14}$",
   "description": "The element's persistent IRI: the base address and the opaque name the ledger holds (iris.jsonl), minted once, carried over a rename a person confirmed (ticket 57)."
  },
  "labels": {
   "type": "object",
   "required": [
    "pref",
    "alt"
   ],
   "additionalProperties": false,
   "description": "skos:prefLabel (one per language) and skos:altLabel, each a text with its language (ticket 57); per language the claim a person decides them on, the decision in force and, once a host placed them, its library and release (ticket 58).",
   "properties": {
    "pref": {
     "$ref": "#/$defs/texts"
    },
    "alt": {
     "$ref": "#/$defs/texts"
    },
    "claims": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/claim"
     }
    },
    "decisions": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/decision"
     }
    },
    "in_layer": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/in_layer"
     }
    }
   }
  },
  "match": {
   "type": "object",
   "required": [
    "key",
    "namespace",
    "read_from"
   ],
   "additionalProperties": false,
   "description": "The host's concept key, read from its alias table by a platform id, never derived from a name (ticket 57). On a value set, members: code says a member is the pair of the key and its code.",
   "properties": {
    "key": {
     "type": "string",
     "pattern": "^(dataset|dimension|measure):[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
    },
    "namespace": {
     "type": "string"
    },
    "read_from": {
     "type": "string",
     "pattern": "^[0-9a-f]{16}$"
    },
    "members": {
     "const": "code"
    }
   }
  }
 }
}

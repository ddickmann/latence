+_SCHEMA_FILES = {1: "proposal-file.schema.json", 2: "proposal-file-2.schema.json",
+                 3: "proposal-file-3.schema.json"}
+
+
+@cache
+def _validator(version: int) -> jsonschema.protocols.Validator:
+    text = files(__package__).joinpath("schema", _SCHEMA_FILES[version]).read_text("utf-8")
+    return jsonschema.Draft202012Validator(json.loads(text))
+
+
+def _checked(document: Mapping[str, Any]) -> None:
+    """Refuse a document that breaks the shipped schema of the version it states (no
+    ``format`` is version 1): the file is the one seam a host reads (ADR-0070)."""
+    stated = document.get("format")
+    version = {None: 1, FORMAT_2: 2, FORMAT_3: 3}.get(stated)
+    if version is None:
+        raise ContractError(f"the proposal file states format {stated!r}, which no shipped "
+                            f"schema describes ({FORMAT_2!r}, {FORMAT_3!r} or none)")
+    broken = sorted(
+        "/".join(str(p) for p in e.absolute_path) or "(the file)"
+        for e in _validator(version).iter_errors(json.loads(json.dumps(document)))
+    )
+    if broken:
+        raise ContractError(f"the proposal file breaks its schema (version {version}) at "
+                            f"{len(broken)} place(s), first {', '.join(broken[:5])}; not written")
+
+

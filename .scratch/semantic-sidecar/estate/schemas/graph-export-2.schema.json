{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-export/2",
  "type": "object",
  "required": [
    "schema",
    "meta",
    "concepts",
    "relations",
    "measures",
    "dropped",
    "nodes",
    "edges",
    "review"
  ],
  "properties": {
    "schema": {
      "const": "graph-export/2"
    },
    "meta": {
      "type": "object",
      "required": [
        "source",
        "title",
        "schema_origin",
        "counts",
        "decisions",
        "host_verified_joins",
        "instances"
      ],
      "properties": {
        "schema_origin": {
          "enum": [
            "induced",
            "declared"
          ]
        },
        "resolution": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "seeded",
            "master",
            "records",
            "labels",
            "labels_from",
            "target",
            "certified",
            "pairs",
            "linked",
            "review_pairs"
          ],
          "properties": {
            "seeded": {
              "type": "boolean"
            },
            "certified": {
              "type": "boolean"
            },
            "reject_line_certified": {
              "type": "boolean"
            },
            "target": {
              "type": "number"
            },
            "labels": {
              "type": "object",
              "required": [
                "training",
                "accept_test",
                "reject_test",
                "total"
              ]
            },
            "checked_against_seed": {
              "type": "object",
              "required": [
                "linked",
                "linked_right",
                "share_right",
                "share_found"
              ]
            }
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measure"
      }
    },
    "dropped": {
      "type": "array"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "concept",
          "label"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "refers_to",
              "fact_count",
              "meet_in",
              "same_as",
              "broader"
            ]
          },
          "p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "detail"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "a",
          "b",
          "reason",
          "strength"
        ],
        "properties": {
          "kind": {
            "enum": [
              "possibly_same"
            ]
          },
          "strength": {
            "enum": [
              "strong",
              "weak"
            ]
          },
          "p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "detail"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "required": [
        "roll_ups",
        "equivalent",
        "part_of",
        "describes"
      ],
      "additionalProperties": false,
      "properties": {
        "roll_ups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "signals"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "declared"
                ]
              },
              "signals": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/signal"
                }
              }
            }
          }
        },
        "equivalent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "signals"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "declared"
                ]
              },
              "signals": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/signal"
                }
              }
            }
          }
        },
        "part_of": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "signals"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "declared"
                ]
              },
              "signals": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/signal"
                }
              }
            }
          }
        },
        "describes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "signals"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "declared"
                ]
              },
              "signals": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/signal"
                }
              }
            }
          }
        }
      }
    },
    "classes": {
      "type": "object",
      "required": [
        "top",
        "classes",
        "subclass_of",
        "voices",
        "unplaced"
      ],
      "properties": {
        "top": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "declared"
                ]
              }
            }
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "declared"
                ]
              }
            }
          }
        },
        "subclass_of": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "concept",
              "parent",
              "status",
              "contested",
              "signals"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed"
                ]
              },
              "contested": {
                "type": "boolean"
              },
              "signals": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/signal"
                }
              }
            }
          }
        },
        "voices": {
          "type": "object",
          "required": [
            "attribute_pattern",
            "language_model"
          ]
        },
        "unplaced": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "required": [
        "kind",
        "detail",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "verdict",
        "by"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "approved",
            "rejected"
          ]
        }
      }
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "label",
        "status",
        "signals",
        "kind",
        "definition",
        "instances"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^concept:"
        },
        "status": {
          "enum": [
            "declared",
            "proposed"
          ]
        },
        "kind": {
          "enum": [
            "entity",
            "fact",
            "reference",
            "derived"
          ]
        },
        "instances": {
          "enum": [
            "available",
            "withheld_personal",
            "without_personal_columns"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "column",
              "label",
              "type",
              "sensitive"
            ],
            "additionalProperties": false,
            "properties": {
              "column": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "sensitive": {
                "type": "boolean"
              }
            }
          }
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "seeded": {
          "type": "boolean"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "label",
        "status",
        "signals",
        "from",
        "to",
        "columns",
        "cardinality",
        "support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^relation:"
        },
        "status": {
          "enum": [
            "declared",
            "proposed"
          ]
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "support": {
          "type": [
            "object",
            "null"
          ]
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      }
    },
    "measure": {
      "type": "object",
      "required": [
        "id",
        "label",
        "name",
        "concept",
        "view",
        "expr",
        "status",
        "signals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^measure:"
        },
        "status": {
          "const": "declared"
        }
      }
    }
  }
}

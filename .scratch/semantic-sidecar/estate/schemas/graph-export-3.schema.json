{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "graph-export/3",
 "type": "object",
 "required": [
  "schema",
  "meta",
  "concepts",
  "relations",
  "measures",
  "dropped",
  "nodes",
  "edges",
  "review"
 ],
 "properties": {
  "schema": {
   "const": "graph-export/3"
  },
  "meta": {
   "type": "object",
   "required": [
    "source",
    "title",
    "schema_origin",
    "counts",
    "decisions",
    "host_verified_joins",
    "instances"
   ],
   "properties": {
    "schema_origin": {
     "enum": [
      "induced",
      "declared"
     ]
    },
    "resolution": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "seeded",
      "master",
      "records",
      "labels",
      "labels_from",
      "target",
      "certified",
      "pairs",
      "linked",
      "review_pairs"
     ],
     "properties": {
      "seeded": {
       "type": "boolean"
      },
      "certified": {
       "type": "boolean"
      },
      "reject_line_certified": {
       "type": "boolean"
      },
      "target": {
       "type": "number"
      },
      "labels": {
       "type": "object",
       "required": [
        "training",
        "accept_test",
        "reject_test",
        "total"
       ]
      },
      "checked_against_seed": {
       "type": "object",
       "required": [
        "linked",
        "linked_right",
        "share_right",
        "share_found"
       ]
      },
      "labels_from": {
       "enum": [
        "seed_truth",
        "reviewer"
       ]
      }
     }
    }
   }
  },
  "concepts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/concept"
   }
  },
  "relations": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/relation"
   }
  },
  "measures": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/measure"
   }
  },
  "dropped": {
   "type": "array"
  },
  "nodes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "concept",
     "label"
    ]
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "from",
     "to",
     "kind"
    ],
    "properties": {
     "kind": {
      "enum": [
       "refers_to",
       "fact_count",
       "meet_in",
       "same_as",
       "broader"
      ]
     },
     "p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/statement"
      }
     }
    }
   }
  },
  "review": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "a",
     "b",
     "reasons",
     "strength",
     "claim"
    ],
    "properties": {
     "kind": {
      "enum": [
       "possibly_same"
      ]
     },
     "strength": {
      "enum": [
       "strong",
       "weak"
      ]
     },
     "p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/statement"
      }
     },
     "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
       "$ref": "#/$defs/statement"
      }
     },
     "claim": {
      "$ref": "#/$defs/claim"
     }
    }
   }
  },
  "structure": {
   "type": "object",
   "required": [
    "describes",
    "equivalent",
    "not_proposed",
    "part_of",
    "roll_ups"
   ],
   "additionalProperties": false,
   "properties": {
    "roll_ups": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "id",
       "signals",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "breaking": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "value",
          "parents"
         ],
         "additionalProperties": false,
         "properties": {
          "value": {
           "type": "string"
          },
          "parents": {
           "type": "array",
           "minItems": 2,
           "items": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     }
    },
    "equivalent": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "id",
       "signals",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "claim": {
        "$ref": "#/$defs/claim"
       }
      }
     }
    },
    "part_of": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "id",
       "signals",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "kind": {
        "enum": [
         "part_of",
         "links"
        ]
       }
      }
     }
    },
    "describes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "id",
       "signals",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "claim": {
        "$ref": "#/$defs/claim"
       }
      }
     }
    },
    "not_proposed": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "concept",
       "signals"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^not_proposed:"
       },
       "concept": {
        "type": "string"
       },
       "entity": {
        "type": "string"
       },
       "signals": {
        "type": "array",
        "minItems": 1,
        "items": {
         "$ref": "#/$defs/signal"
        }
       }
      }
     }
    }
   }
  },
  "classes": {
   "type": "object",
   "required": [
    "top",
    "classes",
    "subclass_of",
    "voices",
    "unplaced"
   ],
   "properties": {
    "top": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "label",
       "label_code",
       "definition",
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "definition": {
        "$ref": "#/$defs/texts"
       },
       "label_code": {
        "type": "string"
       }
      }
     }
    },
    "classes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "label",
       "parent",
       "definition",
       "status",
       "signals",
       "claim"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed",
         "declared"
        ]
       },
       "definition": {
        "$ref": "#/$defs/texts"
       },
       "claim": {
        "$ref": "#/$defs/claim"
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       }
      }
     }
    },
    "subclass_of": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "concept",
       "parent",
       "status",
       "contested",
       "signals",
       "definition",
       "claim"
      ],
      "properties": {
       "status": {
        "enum": [
         "proposed"
        ]
       },
       "contested": {
        "type": "boolean"
       },
       "signals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/signal"
        }
       },
       "definition": {
        "$ref": "#/$defs/texts"
       },
       "claim": {
        "$ref": "#/$defs/claim"
       }
      }
     }
    },
    "voices": {
     "type": "object",
     "required": [
      "attribute_pattern",
      "language_model"
     ]
    },
    "unplaced": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 },
 "$defs": {
  "signal": {
   "$ref": "#/$defs/statement"
  },
  "decision": {
   "type": "object",
   "required": [
    "verdict",
    "by"
   ],
   "properties": {
    "verdict": {
     "enum": [
      "approved",
      "rejected"
     ]
    }
   }
  },
  "concept": {
   "type": "object",
   "required": [
    "claim",
    "definition",
    "id",
    "instances",
    "kind",
    "label",
    "signals",
    "status"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^concept:"
    },
    "status": {
     "enum": [
      "declared",
      "proposed"
     ]
    },
    "kind": {
     "enum": [
      "entity",
      "fact",
      "reference",
      "derived"
     ]
    },
    "instances": {
     "enum": [
      "available",
      "withheld_personal",
      "without_personal_columns"
     ]
    },
    "signals": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/signal"
     }
    },
    "attributes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "column",
       "label",
       "type",
       "sensitive"
      ],
      "additionalProperties": false,
      "properties": {
       "column": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "type": {
        "type": "string"
       },
       "definition": {
        "$ref": "#/$defs/texts"
       },
       "sensitive": {
        "type": "boolean"
       }
      }
     }
    },
    "decision": {
     "$ref": "#/$defs/decision"
    },
    "seeded": {
     "type": "boolean"
    },
    "claim": {
     "$ref": "#/$defs/claim"
    },
    "definition": {
     "$ref": "#/$defs/texts"
    }
   }
  },
  "relation": {
   "type": "object",
   "required": [
    "cardinality",
    "claim",
    "columns",
    "from",
    "id",
    "label",
    "signals",
    "status",
    "support",
    "to"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^relation:"
    },
    "status": {
     "enum": [
      "declared",
      "proposed"
     ]
    },
    "signals": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/signal"
     }
    },
    "support": {
     "type": [
      "object",
      "null"
     ]
    },
    "decision": {
     "$ref": "#/$defs/decision"
    },
    "claim": {
     "$ref": "#/$defs/claim"
    },
    "partial_key": {
     "const": true
    },
    "cardinality": {
     "enum": [
      "many_to_one",
      "many_to_many"
     ]
    }
   }
  },
  "measure": {
   "type": "object",
   "required": [
    "claim",
    "concept",
    "definition",
    "expr",
    "id",
    "label",
    "name",
    "signals",
    "status",
    "view"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^measure:"
    },
    "status": {
     "const": "declared"
    },
    "claim": {
     "$ref": "#/$defs/claim"
    },
    "definition": {
     "$ref": "#/$defs/texts"
    }
   }
  },
  "text": {
   "type": "object",
   "required": [
    "text",
    "lang",
    "origin"
   ],
   "additionalProperties": false,
   "properties": {
    "text": {
     "type": "string",
     "minLength": 1
    },
    "lang": {
     "type": "string",
     "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
    },
    "origin": {
     "type": "string",
     "pattern": "^(catalog|engine|model:.+)$"
    },
    "code": {
     "type": "string"
    }
   }
  },
  "texts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/text"
   }
  },
  "statement": {
   "type": "object",
   "required": [
    "kind",
    "code",
    "params",
    "ref"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "type": "string"
    },
    "code": {
     "type": "string",
     "pattern": "^[a-z_]+(\\.[a-z_]+)*$"
    },
    "params": {
     "type": "object",
     "additionalProperties": {
      "type": [
       "string",
       "number",
       "array"
      ],
      "items": {
       "type": "string"
      }
     }
    },
    "ref": {
     "type": "string"
    },
    "text": {
     "$ref": "#/$defs/text"
    }
   }
  },
  "claim": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  }
 }
}

# Keep the Docker build context lean and free of host-only / sensitive files.
#
# The demo Dockerfile (demo/Dockerfile) already uses an explicit COPY allowlist, so this
# file is defence-in-depth: it stops large, mutable, or secret-bearing host artifacts from
# entering the build context at all (smaller/faster/reproducible builds; no accidental
# secret or venv leak). It does NOT change what lands in the image — the COPY allowlist does.

# Version control + CI metadata
.git
.git/
.github/
.gitignore

# Python caches / build artifacts / virtualenvs
__pycache__/
*.py[cod]
.venv/
.uv/
dist/
build/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Demo run outputs + staged corpus (regenerated on every run; never inputs to the build)
demo/data/
demo/out/

# Local/OS + editor noise
.DS_Store
*.log
.env
.env.*

# Not COPY'd by the Dockerfile anyway (the COPY allowlist governs the image); excluded here
# so they never enter the build context at all, keeping it small and free of stray files.
docs/
issues/
orchestration/
